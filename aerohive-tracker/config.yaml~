# https://developers.home-assistant.io/docs/add-ons/configuration#add-on-config
name: Aerohive Device Tracker
version: "1.0.4"
slug: aerohive_tracker
description: Track WiFi devices accross multiple APs of an Aerohive mesh network.  Only wireless devices are tracked.
arch:
  - armhf
  - armv7
  - aarch64
  - amd64
  - i386
options:
  aerohive_password: ""
  aerohive_host: ""
  aerohive_username: "admin"
  mqtt_host: "localhost"
  mqtt_port: "1883"
  mqtt_username: "" 
  mqtt_password: ""
  preinit_macs: ""
  ignore_regex_mac: "a^"
  ignore_regex_ip: "a^"
  ignore_regex_name: "a^"
  ignore_unnamed_hosts: "True"
  sleep_interval: "30"
  mqtt_first_reconnect_delay: 1
  mqtt_reconnect_rate: 2
  mqtt_max_reconnect_count: 0
  mqtt_max_reconnect_delay: 60
schema:
  aerohive_password: 'password'
  aerohive_host: 'str'
  aerohive_username: 'str'
  mqtt_host: 'str'
  mqtt_port: 'int'
  mqtt_username: 'str'
  mqtt_password: 'password'
  preinit_macs: 'str'
  ignore_regex_mac: 'str'
  ignore_regex_ip: 'str'
  ignore_regex_name: 'str'
  ignore_unnamed_hosts: 'bool'
  sleep_interval: 'int'
  mqtt_first_reconnect_delay: 'int'
  mqtt_reconnect_rate: 'int'
  mqtt_max_reconnect_count: 'int'
  mqtt_max_reconnect_delay: 'int'
